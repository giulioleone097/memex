.worktrees/
**/node_modules/
# Exception: vendored, dependency-free runtime shim required by
# plugins/memex/vendor/ort/ort.node.min.mjs's bare "onnxruntime-common"
# import (see plugins/memex/vendor/MANIFEST.json). This is a checked-in
# vendored asset, not an installed dependency.
!plugins/memex/vendor/ort/node_modules/
!plugins/memex/vendor/ort/node_modules/**
# Exception: vendored, pure-JS runtime dependencies of the LadybugDB wasm
# nodejs variant (threads, uuid, tiny-worker + transitives). Checked-in
# vendored assets so the wasm graph tier resolves them with no install step.
!plugins/memex/vendor/ladybug-wasm/nodejs/node_modules/
!plugins/memex/vendor/ladybug-wasm/nodejs/node_modules/**
**/coverage/
.DS_Store
**/.DS_Store

