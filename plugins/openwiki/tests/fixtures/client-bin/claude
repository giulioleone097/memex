#!/usr/bin/env node
import { appendFileSync, readFileSync, writeFileSync } from "node:fs";

const client = "claude";
const argv = process.argv.slice(2);
const logPath = process.env.OPENWIKI_TEST_LOG;
const statePath = process.env.OPENWIKI_TEST_STATE;

if (!logPath || !statePath) {
  process.stderr.write("Fixture requires OPENWIKI_TEST_LOG and OPENWIKI_TEST_STATE.\n");
  process.exit(64);
}

appendFileSync(logPath, `${JSON.stringify({ client, argv })}\n`);
const state = JSON.parse(readFileSync(statePath, "utf8"));
const clientState = state[client];

function save() {
  writeFileSync(statePath, `${JSON.stringify(state, null, 2)}\n`);
}

function output(value) {
  process.stdout.write(`${JSON.stringify(value)}\n`);
}

if (argv[0] === "plugin" && argv[1] === "marketplace" && argv[2] === "list") {
  output(clientState.marketplaces);
} else if (argv[0] === "plugin" && argv[1] === "marketplace" && argv[2] === "add") {
  const source = argv[3];
  clientState.marketplaces.push({
    name: "openwiki-local",
    source: "directory",
    path: source,
    installLocation: source,
  });
  save();
  output({ ok: true });
} else if (argv[0] === "plugin" && argv[1] === "marketplace" && argv[2] === "remove") {
  clientState.marketplaces = clientState.marketplaces.filter(({ name }) => name !== argv[3]);
  save();
  output({ ok: true });
} else if (argv[0] === "plugin" && argv[1] === "list") {
  output(clientState.installed);
} else if (argv[0] === "plugin" && argv[1] === "install") {
  clientState.installed.push({
    id: argv[2],
    name: "openwiki",
    marketplace: "openwiki-local",
    enabled: true,
  });
  save();
  output({ ok: true });
} else if (argv[0] === "plugin" && argv[1] === "uninstall") {
  clientState.installed = clientState.installed.filter(({ id }) => id !== argv[2]);
  save();
  output({ ok: true });
} else {
  process.stderr.write(`Unsupported Claude fixture argv: ${JSON.stringify(argv)}\n`);
  process.exit(64);
}
